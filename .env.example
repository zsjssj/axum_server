# 运行模式: development, production
RUN_MODE=default

# 也可以通过环境变量覆盖配置（使用 APP__ 前缀，双下划线分隔）
APP__SERVER__HOST=0.0.0.0
APP__SERVER__PORT=3000
APP__DATABASE__URL=postgresql://localhost:5432/postgres
APP__LOG__LEVEL=info

# Redis：登录失败计数、access token 吊销列表与用户资料缓存。
# 未启动 Redis 时服务仍可运行，但限流会回退数据库、吊销与缓存会跳过，
# 并且 /ready 会返回 503。学习与配置说明见 docs/README.md 与 docs/reference/REDIS_GUIDE.md。
APP__REDIS__URL=redis://127.0.0.1:6379
APP__REDIS__POOL_SIZE=8
APP__REDIS__KEY_PREFIX=axum
APP__REDIS__USER_CACHE_TTL_SECONDS=60

# JWT 签名密钥：生产环境必须替换为高强度随机值，长度不少于 32 个字符。
# 可用 `openssl rand -base64 48` 生成。
APP__JWT__SECRET=replace-with-a-random-secret-at-least-32-chars

# 令牌 Cookie：生产环境（HTTPS）必须设置为 true。
APP__AUTH__COOKIE__SECURE=false

# 引导账号：仅当数据库还没有任何用户时创建，用于解开
# 「登录需要用户、建用户需要登录」的死锁。凭据不要提交到仓库。
APP__BOOTSTRAP__ENABLED=false
APP__BOOTSTRAP__USERNAME=
APP__BOOTSTRAP__EMAIL=
APP__BOOTSTRAP__PASSWORD=
